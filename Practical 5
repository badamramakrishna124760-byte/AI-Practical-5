
# Rule-Based Expert System for Disease Diagnosis

print("======================================")
print("     MEDICAL EXPERT SYSTEM")
print("======================================")

print("\nAnswer the following questions with yes or no.")

fever = input("Do you have fever? (yes/no): ").lower()
cough = input("Do you have cough? (yes/no): ").lower()
headache = input("Do you have headache? (yes/no): ").lower()
cold = input("Do you have cold or sneezing? (yes/no): ").lower()
body_pain = input("Do you have body pain? (yes/no): ").lower()
sore_throat = input("Do you have sore throat? (yes/no): ").lower()

print("\n========== DIAGNOSIS RESULT ==========")

# Rule 1
if fever == "yes" and cough == "yes" and body_pain == "yes":
    print("Possible Condition: Flu")
    print("Advice: Rest, drink fluids and consult a doctor if symptoms persist.")

# Rule 2
elif cold == "yes" and cough == "yes" and fever == "no":
    print("Possible Condition: Common Cold")
    print("Advice: Take adequate rest and drink plenty of fluids.")

# Rule 3
elif fever == "yes" and headache == "yes" and body_pain == "yes":
    print("Possible Condition: Possible Viral Infection")
    print("Advice: Consult a healthcare professional.")

# Rule 4
elif sore_throat == "yes" and cough == "yes":
    print("Possible Condition: Throat Infection")
    print("Advice: Seek medical advice if symptoms are severe or persistent.")

# Rule 5
elif headache == "yes" and fever == "no":
    print("Possible Condition: Possible Headache")
    print("Advice: Rest and seek medical advice if it continues.")

# Default Rule
else:
    print("Condition: No matching rule found.")
    print("Advice: Consult a healthcare professional for proper evaluation.")

print("======================================")
print("Note: This is an educational expert system,")
print("not a substitute for professional diagnosis.")
print("======================================")
